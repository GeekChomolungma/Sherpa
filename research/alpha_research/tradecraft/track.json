{
  "id": "tradecraft",
  "description": "交易经验 alpha（sherpa/alpha/custom/tradecraft/）：规则直接打分、不训练。步骤 0 逐期 RankIC 时间线，之后阶段一 -> 关卡1/2 透传 -> 关卡3",
  "alphas": {
    "modules": ["sherpa.alpha.custom.tradecraft"],
    "family": "custom",
    "include": ["custom.tc_surge_calm_v2"]
  },
  "outputs": {
    "per_run": true
  },
  "preprocess": {
    "tradable_mask": {"min_percentile": 0.5, "min_quote_volume": 0, "min_trades_count": 0},
    "neutralize": false
  },
  "regime": {
    "dimensions": ["trend", "volatility", "dispersion", "liquidity"]
  },
  "report": {
    "matrix_top_k": 5,
    "min_abs_t": 0.0
  },
  "stages": {
    "orthogonalization": {"mode": "passthrough"},
    "synthesis": {
      "mode": "passthrough",
      "passthrough": {"singles": true, "equal_weight": false, "routed": false, "direction": "as_is"}
    }
  }
}
